---
interface Props {
  title: string;
  //description: string;
  //icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="feature-card">
  <div class="feature-icon">
    <!-- 这里可以使用 SVG 图标 -->
    <span>{icon}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</div>

<style>
  .feature-card {
    text-align: center;
    padding: 30px;
    border-radius: var(--border-radius);
    background: white;
    box-shadow: var(--shadow);
    transition: var(--transition);
  }

  .feature-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #333;
    line-height: 1.4;
    margin: 0 0 10px;
    text-align: center;
    white-space: normal;      /* 允许换行 */
    word-break: keep-all;     /* 单词不拆开 */
    overflow-wrap: break-word; /* 超长整词换行 */
  }

  /* 描述样式：整行换行，不在单词中间断开 */
  .feature-card p {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
    text-align: center;
    white-space: normal;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
  }

  .feature-icon {
    width: 20px;
    height: 20px;
    background: var(--secondary-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: white;
    font-size: 1.5rem;
  }
</style>